---
import { site, waLink } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="bg-navy-900 text-seal-100 mt-24">
  <div class="container py-16">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 font-display font-bold text-white text-lg mb-4">
          <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="#DBF2FC" stroke="#FFFFFF" stroke-width="2"/>
            <path d="M16 8c-3 4-6 6-6 10a6 6 0 0 0 12 0c0-4-3-6-6-10z" fill="#FFFFFF"/>
            <circle cx="16" cy="20" r="2" fill="#5FC8ED"/>
          </svg>
          <span>Modi Hydroshop</span>
        </div>
        <p class="text-sm text-seal-200 leading-relaxed">{site.tagline}</p>
        <a href={waLink()} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-seal-600 hover:text-seal-500">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Chat on WhatsApp
        </a>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Products</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/products" class="hover:text-white transition-colors">All Products</a></li>
          <li><a href="/products?cat=still-water" class="hover:text-white transition-colors">Still Water</a></li>
          <li><a href="/products?cat=sparkling-water" class="hover:text-white transition-colors">Sparkling Water</a></li>
          <li><a href="/products?cat=juice" class="hover:text-white transition-colors">Natural Juice</a></li>
          <li><a href="/products?cat=ice-cubes" class="hover:text-white transition-colors">Ice Cubes</a></li>
          <li><a href="/products?cat=refill" class="hover:text-white transition-colors">Refill</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="/quality" class="hover:text-white transition-colors">Quality</a></li>
          <li><a href="/clients" class="hover:text-white transition-colors">Clients</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Insights</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li>{site.phone}</li>
          <li><a href={`mailto:${site.email}`} class="hover:text-white transition-colors">{site.email}</a></li>
          <li>{site.address.street}, {site.address.city}</li>
          <li>{site.address2.street}, {site.address2.city}</li>
          <li>{site.hours}</li>
        </ul>
        <div class="mt-4 text-xs text-seal-300">
          <a href="/privacy" class="hover:text-white">Privacy</a> ·
          <a href="/terms" class="hover:text-white">Terms</a> ·
          <a href="/popia" class="hover:text-white">POPIA</a>
        </div>
      </div>
    </div>

    <div class="border-t border-navy-700 mt-12 pt-6 flex flex-col md:flex-row justify-between gap-4 text-xs text-seal-300">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>Built with care in South Africa.</p>
    </div>
  </div>
</footer>
