---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, waLink } from '@/data/site';
---
<BaseLayout title="Contact Us" description="Get in touch with Modi Hydroshop for quotes, delivery enquiries, hospitality supply, water testing, events, or refill stations.">
  <section class="section-sm bg-seal-50">
    <div class="container">
      <h1 class="heading-1 text-foreground mb-4">Get in Touch</h1>
      <p class="body-lg text-muted-foreground max-w-2xl">Ready for premium hydration? Request a quote, ask a question, or start a partnership. We respond within 24 hours during business days.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="heading-2 text-foreground mb-6">Send Us a Message</h2>
          <form id="contact-form" class="space-y-4" onsubmit="return false;">
            <div>
              <label for="name" class="block text-sm font-medium mb-1">Name</label>
              <input id="name" name="name" type="text" required class="w-full rounded-lg border border-line px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-navy-900" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium mb-1">Email</label>
              <input id="email" name="email" type="email" required class="w-full rounded-lg border border-line px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-navy-900" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium mb-1">Phone / WhatsApp</label>
              <input id="phone" name="phone" type="tel" class="w-full rounded-lg border border-line px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-navy-900" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium mb-1">Message</label>
              <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-line px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-navy-900"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-full sm:w-auto">Send via WhatsApp</button>
            <p class="text-xs text-muted-foreground">Submitting opens WhatsApp with your message pre-filled. We'll reply there.</p>
          </form>
        </div>

        <div class="space-y-8">
          <div>
            <h3 class="heading-3 text-foreground mb-4">Other Ways to Reach Us</h3>
            <dl class="space-y-6">
              <div class="flex items-start gap-4">
                <dt class="flex-shrink-0 w-12 h-12 rounded-xl bg-seal-100 text-foreground flex items-center justify-center" aria-hidden="true">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </dt>
                <dd>
                  <h4 class="font-medium">Email</h4>
                  <a href={`mailto:${site.email}`} class="text-muted-foreground hover:text-foreground transition-colors">{site.email}</a>
                  <p class="text-sm text-muted-foreground mt-1">General enquiries & quotes</p>
                </dd>
              </div>
              <div class="flex items-start gap-4">
                <dt class="flex-shrink-0 w-12 h-12 rounded-xl bg-seal-100 text-foreground flex items-center justify-center" aria-hidden="true">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </dt>
                <dd>
                  <h4 class="font-medium">Phone</h4>
                  <a href={`tel:${site.phone.replace(/\s/g,'')}`} class="text-muted-foreground hover:text-foreground transition-colors">{site.phone}</a>
                  <p class="text-sm text-muted-foreground mt-1">{site.hours}</p>
                </dd>
              </div>
              <div class="flex items-start gap-4">
                <dt class="flex-shrink-0 w-12 h-12 rounded-xl bg-seal-100 text-foreground flex items-center justify-center" aria-hidden="true">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </dt>
                <dd>
                  <h4 class="font-medium">Visit Us</h4>
                  <address class="text-muted-foreground not-italic">
                    {site.address.street}<br/>
                    {site.address.city}, {site.address.region} {site.address.postalCode}<br/>
                    South Africa
                  </address>
                  <address class="text-muted-foreground not-italic mt-3">
                    {site.address2.street}<br/>
                    {site.address2.city}, {site.address2.region} {site.address2.postalCode}<br/>
                    South Africa
                  </address>
                  <p class="text-sm text-muted-foreground mt-1">Refill station open Mon–Sat</p>
                </dd>
              </div>
            </dl>
          </div>

          <div class="card p-6 bg-surface-2">
            <h3 class="heading-3 text-foreground mb-3">Quick Refill Quote</h3>
            <p class="text-muted-foreground mb-4 text-sm">Need a quick estimate for refill station services?</p>
            <a href={waLink('Hi, I need a refill station quote.')} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">Get refill quote via WhatsApp</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const phone = document.getElementById('phone').value;
      const message = document.getElementById('message').value;
      const text = `Hi Modi Hydroshop, my name is ${name}. Email: ${email}. Phone: ${phone}. Message: ${message}`;
      window.open(`https://wa.me/27637202467?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
</script>
