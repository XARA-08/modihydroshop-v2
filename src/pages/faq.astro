---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { waLink } from '@/data/site';
import FAQ from '@/components/wamambo/FAQ';

const faqs = (await getCollection('faqs')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="FAQ" description="Frequently asked questions about our water purification, products, delivery, refill service, quality testing, and certifications.">
  <section class="section-sm bg-seal-50">
    <div class="container">
      <h1 class="heading-1 text-foreground mb-4">Frequently Asked Questions</h1>
      <p class="body-lg text-muted-foreground max-w-2xl">Quick answers to common questions. Can't find what you need? <a href="/contact" class="link">Contact us</a>.</p>
    </div>
  </section>

  <FAQ client:load heading="Frequently Asked Questions" subheading="Quick answers to common questions." items={faqs.map(f => ({ q: f.data.question, a: f.data.answer }))} />

  <section class="section bg-navy-900 text-white text-center">
    <div class="container">
      <h2 class="heading-2 mb-4">Still have questions?</h2>
      <p class="body-lg text-seal-200 mb-8 max-w-2xl mx-auto">Our team is here to help.</p>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg">Chat on WhatsApp</a>
    </div>
  </section>
</BaseLayout>
