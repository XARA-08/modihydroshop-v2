---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, waLink } from '@/data/site';

const values = (await getCollection('values')).sort((a,b)=>a.data.order-b.data.order);
const team = (await getCollection('team')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="About Us" description="Learn about Modi Hydroshop — a premium water purification and bottling company founded in 2020.">
  <section class="section-sm bg-seal-50">
    <div class="container max-w-3xl">
      <h1 class="heading-1 text-navy-900 mb-6">About Modi Hydroshop</h1>
      <p class="body-lg text-muted">
        Founded in {site.founded}, Modi Hydroshop Pty Ltd has grown from a local water purification startup into a trusted supplier of premium hydration solutions across Limpopo and Gauteng.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-3xl">
      <h2 class="heading-2 text-navy-900 mb-6">Our Story</h2>
      <p class="body text-muted mb-4">
        We started with a simple idea: every business and household deserves access to genuinely pure water. Today we serve offices, hospitality venues, retail partners and events — with still water, sparkling water, natural juice, crystal ice and refill services.
      </p>
      <p class="body text-muted">
        Our team combines water science, operations and distribution expertise to deliver consistent quality, on time, every time.
      </p>
    </div>
  </section>

  <section class="section bg-surface-2">
    <div class="container">
      <header class="mb-10">
        <h2 class="heading-2 text-navy-900 mb-3">Our Values</h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {values.map((v) => (
          <article class="card p-6 reveal">
            <h3 class="heading-4 text-navy-900 mb-2">{v.data.title}</h3>
            <p class="text-sm text-muted">{v.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="mb-10">
        <h2 class="heading-2 text-navy-900 mb-3">Leadership</h2>
        <p class="body text-muted">The people driving Modi Hydroshop's mission.</p>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {team.map((m) => (
          <article class="card p-6 reveal text-center">
            <div class="w-16 h-16 rounded-full bg-seal-200 mx-auto mb-4 flex items-center justify-center text-navy-900 font-bold text-xl">
              {m.data.name.split(' ').map(n=>n[0]).join('').slice(0,2)}
            </div>
            <h3 class="heading-4 text-navy-900">{m.data.name}</h3>
            <p class="text-sm text-crimson-500 font-medium mb-2">{m.data.role}</p>
            <p class="text-sm text-muted">{m.data.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-surface-2 text-center">
    <div class="container">
      <h2 class="heading-2 text-navy-900 mb-4">Want to work with us?</h2>
      <p class="body-lg text-muted mb-6">We're always open to partnerships and new clients.</p>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Get in touch</a>
    </div>
  </section>
</BaseLayout>
