---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import LegalLayout from '@/components/wamambo/LegalLayout';
---
<BaseLayout title="POPIA Notice" description="POPIA compliance notice for Modi Hydroshop." noIndex={true}>
  <LegalLayout client:load title="POPIA Notice" intro="In accordance with the Protection of Personal Information Act." effectiveDate="2026">
    <p class="text-muted-foreground">In accordance with the Protection of Personal Information Act (POPIA), {site.legalName} processes personal information lawfully and reasonably. You have the right to access, correct or delete your personal information, and to object to processing. Requests: <a href={`mailto:${site.email}`} class="link">{site.email}</a>.</p>
  </LegalLayout>
</BaseLayout>
