---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---
<BaseLayout title="POPIA Notice" description="POPIA compliance notice for Modi Hydroshop." noIndex={true}>
  <section class="section">
    <div class="container max-w-3xl">
      <h1 class="heading-1 text-navy-900 mb-6">POPIA Notice</h1>
      <p class="text-muted">In accordance with the Protection of Personal Information Act (POPIA), {site.legalName} processes personal information lawfully and reasonably. You have the right to access, correct or delete your personal information, and to object to processing. Requests: <a href={`mailto:${site.email}`} class="link">{site.email}</a>.</p>
    </div>
  </section>
</BaseLayout>
