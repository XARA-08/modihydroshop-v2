---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, waLink } from '@/data/site';
---
<BaseLayout title="Our Clients" description="Modi Hydroshop supplies purified water, sparkling water, juice, ice and refill services to businesses, hospitality venues and events across Limpopo and Gauteng.">
  <section class="section-sm bg-seal-50">
    <div class="container">
      <h1 class="heading-1 text-foreground mb-4">Our Clients</h1>
      <p class="body-lg text-muted-foreground max-w-2xl">We partner with businesses, hospitality venues, offices and events across Limpopo and Gauteng.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="mb-10">
        <h2 class="heading-2 text-foreground mb-3">Who We Serve</h2>
        <p class="body text-muted-foreground">Hydration solutions tailored to each sector's volume, quality and delivery needs.</p>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {[
          { title: 'Hospitality & HORECA', desc: 'Hotels, restaurants, bars and lodges — crystal ice, sparkling water and custom-branded bottles.' },
          { title: 'Corporate Offices', desc: 'Refill stations, scheduled bulk delivery and wellness-aligned hydration programs.' },
          { title: 'Retail Partners', desc: 'Stocking and refill station hosting for local retailers.' },
          { title: 'Events & Conferences', desc: 'Mobile refill stations, branded water and ice for events of any scale.' },
        ].map((seg) => (
          <article class="card p-6 reveal">
            <h3 class="heading-4 text-foreground mb-3">{seg.title}</h3>
            <p class="text-sm text-muted-foreground">{seg.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-surface-2 text-center">
    <div class="container max-w-2xl">
      <h2 class="heading-2 text-foreground mb-4">Client Testimonials</h2>
      <p class="body-lg text-muted-foreground mb-6">We are collecting verified testimonials from our clients. If you are a Modi Hydroshop client and would like to be featured, please get in touch.</p>
      <a href={waLink('Hi, I would like to share my experience as a Modi Hydroshop client.')} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Share Your Experience</a>
    </div>
  </section>
</BaseLayout>
