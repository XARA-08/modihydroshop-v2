---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, waLink } from '@/data/site';

const products = (await getCollection('products')).filter(p=>p.data.featured).sort((a,b)=>a.data.order-b.data.order);
const services = (await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.legalName,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    {
      '@type': 'PostalAddress',
      streetAddress: site.address2.street,
      addressLocality: site.address2.city,
      addressRegion: site.address2.region,
      postalCode: site.address2.postalCode,
      addressCountry: site.address2.country,
    },
  ],
  foundingDate: site.founded,
  areaServed: ['Limpopo', 'Gauteng'],
};

const waQuote = (product?: string) =>
  waLink(product ? `Hi Modi Hydroshop, I'd like a quote for ${product}.` : "Hi Modi Hydroshop, I'd like a quote.");
---

<BaseLayout title={`${site.name} | Pure Water Bottling & Purification — Limpopo & Gauteng`} description={site.description} structuredData={structuredData}>
  <section class="hero-mesh relative min-h-[680px] md:min-h-[760px] flex items-center overflow-hidden bg-navy-900 text-white">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1536939459926-301728717817?w=1600&q=60&auto=format&fit=crop"
        alt="Rows of purified bottled water on a production line - placeholder image, replace with real Modi Hydroshop facility photo"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1600" height="900"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900 via-navy-900/90 to-navy-900/50"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-transparent to-transparent"></div>
    </div>

    <div class="container relative z-10 py-24 md:py-32">
      <div class="max-w-3xl">
        <span class="badge badge-seal mb-6 inline-flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-seal-400 animate-pulse" aria-hidden="true"></span>
          Established {site.founded} · Modimolle, Limpopo
        </span>
        <h1 class="heading-1 mb-6 leading-[1.02] tracking-tight">
          Reverse Osmosis purified water,<br class="hidden md:block" />
          bottled in Modimolle,<br class="hidden md:block" />
          delivered across Limpopo &amp; Gauteng.
        </h1>
        <p class="body-lg text-seal-100 max-w-2xl mb-10 leading-relaxed">
          {site.description}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={waQuote()} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg shadow-lg hover:shadow-xl transition-shadow">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Get a quote on WhatsApp
          </a>
          <a href="/products" class="btn btn-lg border border-white/30 text-white hover:bg-white hover:text-navy-900 backdrop-blur-sm">
            View products
          </a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-seal-200">
          <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-seal-400" aria-hidden="true"></span>B-BBEE Level 1</span>
          <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-seal-400" aria-hidden="true"></span>CIPC registered</span>
          <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-seal-400" aria-hidden="true"></span>Certificates of Analysis on request</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-surface">
    <div class="container py-6 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <div class="heading-4 text-foreground">B-BBEE</div>
        <div class="caption">Level 1 contributor</div>
      </div>
      <div>
        <div class="heading-4 text-foreground">CIPC</div>
        <div class="caption">Registered company</div>
      </div>
      <div>
        <div class="heading-4 text-foreground">RO</div>
        <div class="caption">Multi-stage purification</div>
      </div>
      <div>
        <div class="heading-4 text-foreground">2</div>
        <div class="caption">Provinces served</div>
      </div>
    </div>
  </section>

  <section class="section bg-surface-2">
    <div class="container">
      <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
        <div>
          <h2 class="heading-2 text-foreground mb-2">Featured products</h2>
          <p class="body text-muted-foreground">Our most popular hydration solutions for homes, offices and events.</p>
        </div>
        <a href="/products" class="btn btn-outline btn-sm">View all products</a>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <article class="card overflow-hidden reveal">
            <img
              src={`https://picsum.photos/seed/${encodeURIComponent(p.id)}/600/176`}
              alt={`${p.data.name} - placeholder image, replace with real product photo`}
              class="w-full h-44 object-cover"
              loading="lazy"
              width="600" height="176"
            />
            <div class="p-6">
              <span class="badge badge-seal mb-3">{p.data.category.replace('-', ' ')}</span>
              <h3 class="heading-4 text-foreground mb-1">{p.data.name}</h3>
              <p class="text-sm text-muted-foreground mb-4">{p.data.tagline}</p>
              {p.data.sizes.length > 0 ? (
                <p class="text-sm font-semibold text-foreground mb-4">
                  From R{Math.min(...p.data.sizes.map(s=>s.price)).toFixed(2)}
                </p>
              ) : (
                <p class="text-sm font-semibold text-foreground mb-4">Quote on request</p>
              )}
              <div class="flex items-center gap-3">
                <a href={waQuote(p.data.name)} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-sm">
                  Get a quote
                </a>
                <a href={`/products/${p.id.replace('.md','')}`} class="text-sm font-semibold text-foreground hover:text-seal-600">
                  Details →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <header class="mb-8">
            <h2 class="heading-2 text-foreground mb-3">How we purify</h2>
            <p class="body-lg text-muted-foreground">A rigorous, multi-stage Reverse Osmosis process — from source to sealed bottle. Every batch is tested before release.</p>
          </header>
          <ol class="grid gap-4" role="list">
            {[
              { n: '01', t: 'Source', d: 'Municipal water sourced and pre-filtered to remove sediment and chlorine.' },
              { n: '02', t: 'Reverse Osmosis', d: 'High-pressure RO membranes remove dissolved solids, bacteria and impurities.' },
              { n: '03', t: 'Mineral Balance', d: 'Controlled remineralisation for taste and pH balance.' },
              { n: '04', t: 'UV & Ozone', d: 'Final disinfection for microbiological safety.' },
              { n: '05', t: 'Bottling', d: 'Automated, hygienic filling and sealing in food-grade facilities.' },
              { n: '06', t: 'Quality Check', d: 'Every batch tested before release. Certificates of Analysis on request.' },
            ].map((s) => (
              <li class="flex gap-4 reveal">
                <div class="text-sm font-bold text-seal-600 w-8 shrink-0">{s.n}</div>
                <div>
                  <h3 class="heading-4 text-foreground mb-1">{s.t}</h3>
                  <p class="text-sm text-muted-foreground">{s.d}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="mt-8">
            <a href="/quality" class="btn btn-outline">Learn about our quality</a>
          </div>
        </div>
        <div class="reveal">
          <img
            src="https://images.unsplash.com/photo-1678938989453-6e57d76d5a4a?w=800&q=75&auto=format&fit=crop"
            alt="Reverse osmosis purification equipment in a water bottling facility - placeholder image"
            class="w-full h-[420px] object-cover rounded-2xl shadow-card"
            loading="lazy"
            width="800" height="420"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface-2">
    <div class="container">
      <header class="max-w-2xl mb-10">
        <h2 class="heading-2 text-foreground mb-3">Our services</h2>
        <p class="body-lg text-muted-foreground">Complete hydration solutions for homes, businesses, and events of any scale.</p>
      </header>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="card p-6 reveal">
            <h3 class="heading-4 text-foreground mb-2">{s.data.name}</h3>
            <p class="text-sm text-muted-foreground mb-4">{s.data.description}</p>
            <ul class="text-sm text-muted-foreground space-y-1">
              {s.data.features.slice(0,3).map((f) => <li>· {f}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="mt-10">
        <a href="/services" class="btn btn-outline">All services</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-12 items-center mb-12">
        <div>
          <h2 class="heading-2 text-foreground mb-4">Built in Modimolle, serving our communities</h2>
          <p class="body text-muted-foreground mb-4">
            Founded in {site.founded} by Lesiba Maleka, Modi Hydroshop Pty Ltd purifies and bottles water in Modimolle, Limpopo, with a second base in Soweto, Gauteng. We source, train, motivate and guide our staff from the local communities we serve.
          </p>
          <p class="body text-muted-foreground mb-6">
            <strong class="text-foreground">Vision:</strong> To become the top supplier of bottled water and allied products in the country — a reputable, trustworthy alternative to the bigger suppliers.
          </p>
          <a href="/about" class="btn btn-outline">Our story</a>
        </div>
        <div class="grid grid-cols-2 gap-4 reveal">
          {[
            { t: 'Integrity', d: 'We conduct our business ethically and honestly.' },
            { t: 'Quality', d: 'Quality products with the best value for money.' },
            { t: 'Safety', d: 'Zero harm to people and the environment.' },
            { t: 'Respect', d: 'We value every individual and their differences.' },
          ].map((v) => (
            <div class="card p-5">
              <h3 class="heading-4 text-foreground mb-1">{v.t}</h3>
              <p class="text-xs text-muted-foreground">{v.d}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-2xl p-8 md:p-10 bg-seal-50 border border-seal-200">
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <h3 class="heading-4 text-foreground mb-2">Water stewardship</h3>
            <p class="text-sm text-muted-foreground">Responsible sourcing and efficient RO processing to minimise waste per litre bottled.</p>
          </div>
          <div>
            <h3 class="heading-4 text-foreground mb-2">Local jobs</h3>
            <p class="text-sm text-muted-foreground">We source, train and grow staff from Modimolle and Soweto communities.</p>
          </div>
          <div>
            <h3 class="heading-4 text-foreground mb-2">B-BBEE Level 1</h3>
            <p class="text-sm text-muted-foreground">Verified contributor status, supporting procurement and enterprise development.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--
    TESTIMONIALS / CLIENT LOGOS STRIP — PLACEHOLDER (hidden until data arrives)
    To enable: collect client names, logos (with permission) and short quotes from Mr. Lesiba,
    then add a 'testimonials' content collection in src/content.config.ts and render here.
    Markup template:
    <section class="section bg-surface">
      <div class="container">
        <header class="max-w-2xl mb-10">
          <h2 class="heading-2 text-foreground mb-3">Trusted by businesses across Limpopo &amp; Gauteng</h2>
          <p class="body-lg text-muted-foreground">Real partners, real results.</p>
        </header>
        <div class="grid gap-6 md:grid-cols-3">
          {testimonials.map((t) => (
            <article class="card p-6">
              <p class="text-sm text-muted-foreground mb-4">"{t.quote}"</p>
              <div class="font-semibold text-foreground">{t.name}</div>
              <div class="text-xs text-muted-foreground">{t.role}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  -->

  <section class="section bg-navy-900 text-white">
    <div class="container max-w-3xl text-center">
      <h2 class="heading-2 mb-4">Ready for premium hydration?</h2>
      <p class="body-lg text-seal-200 mb-8">
        Custom solutions, volume pricing and dedicated support for your business, hospitality venue or event. Get a quote today.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={waQuote()} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg">
          Get a quote on WhatsApp
        </a>
        <a href="mailto:lesibabdmaleka@gmail.com?subject=Quote%20request%20-%20Modi%20Hydroshop" class="btn btn-lg border border-white/40 text-white hover:bg-white hover:text-navy-900">
          Email us
        </a>
      </div>
      <p class="caption text-seal-100 mt-6">
        Or call {site.phone} · Mon–Fri 8am–5pm, Sat 8am–1pm
      </p>
    </div>
  </section>
</BaseLayout>
