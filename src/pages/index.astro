---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, waLink } from '@/data/site';
import { Card, Stats, Stat, Badge, Button } from '@ppreeper/neokit';
import Silk from '../components/wamambo/Silk';
import { MorphHeadline } from '../components/wamambo/MorphHeadline';
import SpecularButton from '../components/wamambo/SpecularButton';
import { GradientHeading } from 'astro-component-kit/typography';
import { ShimmerButton } from 'astro-component-kit/buttons';
import ProcessPath from '../components/wamambo/ProcessPath';
import CursorGrid from '../components/wamambo/CursorGrid';
import Strands from '../components/wamambo/Strands';
import ValueProps from '../components/wamambo/ValueProps';
import TrustStrip from '../components/wamambo/TrustStrip';
import BorderGlow from '../components/wamambo/BorderGlow';
import SocialCard from '../components/wamambo/SocialCard';
import ReadinessBand from '../components/wamambo/ReadinessBand';
import { TrustBadges } from 'astro-component-kit/ecommerce';

const products = (await getCollection('products')).filter(p=>p.data.featured).sort((a,b)=>a.data.order-b.data.order);
const services = (await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.legalName,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  address: [
    {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.city,
      addressRegion: site.address.region,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    {
      '@type': 'PostalAddress',
      streetAddress: site.address2.street,
      addressLocality: site.address2.city,
      addressRegion: site.address2.region,
      postalCode: site.address2.postalCode,
      addressCountry: site.address2.country,
    },
  ],
  foundingDate: site.founded,
  areaServed: ['Limpopo', 'Gauteng'],
};

const waQuote = (product?: string) =>
  waLink(product ? `Hi Modi Hydroshop, I'd like a quote for ${product}.` : "Hi Modi Hydroshop, I'd like a quote.");
---

<BaseLayout title={`${site.name} | Pure Water Bottling & Purification — Limpopo & Gauteng`} description={site.description} structuredData={structuredData}>

  <section class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-navy-900 text-white">
    <div class="absolute inset-0">
          <Silk client:load speed={5} scale={1} color="#1B3A6B" noiseIntensity={1.1} rotation={0} />
          <CursorGrid client:load color="#2D7DD2" cellSize={60} radius={120} maxOpacity={0.3} gridOpacity={0.05} />
          <div class="absolute inset-0 bg-navy-950/25" />
          <div class="absolute inset-0 bg-gradient-to-b from-navy-950/20 via-transparent to-navy-950/80" />
        </div>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pt-28 md:px-8 md:pt-36">
      <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
        <div class="reveal inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-sm text-seal-100 mb-8">
          <span class="w-2 h-2 rounded-full bg-seal-400 animate-pulse" aria-hidden="true"></span>
          <span class="font-medium">Established {site.founded} · Modimolle, Limpopo</span>
        </div>
        <MorphHeadline client:load as="h1" className="mb-8 font-bold leading-[1.04] tracking-tight text-white min-h-[1.2em]" style={{ fontSize: 'clamp(2.6rem, 6vw, 5.25rem)' }}>
          Pure water,<br />bottled with care.
        </MorphHeadline>
        <p class="max-w-2xl text-body-lg leading-relaxed text-seal-100/90 mb-10">
          {site.description}
        </p>
        <div class="flex flex-wrap gap-4 mb-12">
          <SpecularButton client:load href={waQuote()} target="_blank" rel="noopener noreferrer" size="lg" baseColor="#2D7DD2" lineColor="#7DD3FC" textColor="#FFFFFF">
            Get a quote on WhatsApp
          </SpecularButton>
          <a href="/products" class="btn btn-lg border border-white/25 text-white hover:bg-white hover:text-navy-900 backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5">
            Explore products
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-seal-200/80 pt-6 border-t border-white/10">
          <span class="inline-flex items-center gap-2">B-BBEE Level 1</span>
          <span class="inline-flex items-center gap-2">CIPC registered</span>
          <span class="inline-flex items-center gap-2">RO purified & tested</span>
          <span class="inline-flex items-center gap-2">Limpopo & Gauteng</span>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 inset-x-0 pointer-events-none">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" preserveAspectRatio="none">
        <path d="M0 80L60 72C120 64 240 48 360 40C480 32 600 32 720 36C840 40 960 48 1080 52C1200 56 1320 56 1380 56L1440 56V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <section class="bg-surface border-b border-line">
    <div class="container py-6">
      <TrustBadges items={[
        { icon: 'lock', title: 'B-BBEE Level 1', text: 'Contributor status' },
        { icon: 'chat', title: 'CIPC Registered', text: 'Registered company' },
        { icon: 'return', title: 'RO Purified', text: 'Multi-stage filtration' },
        { icon: 'truck', title: '2 Provinces', text: 'Limpopo & Gauteng' },
      ]} variant="inline" size="md" />
    </div>
  </section>

  <section class="section bg-surface-2">
    <div class="container">
      <header class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
        <div class="max-w-xl">
          <span class="badge badge-seal mb-3">Our range</span>
          <h2 class="heading-2 text-foreground mb-3">Featured products</h2>
          <p class="body text-muted-foreground">Our most popular hydration solutions for homes, offices and events.</p>
        </div>
        <a href="/products" class="btn btn-outline btn-sm self-start md:self-end">View all products →</a>
      </header>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {products.map((p) => (
          <div class="reveal-child">
            <Card
              title={p.data.name}
              imageSrc={`https://picsum.photos/seed/${encodeURIComponent(p.id)}/600/240`}
              imageAlt={`${p.data.name} - placeholder image, replace with real product photo`}
              classes="group bg-white border border-line shadow-soft hover:shadow-lift hover:-translate-y-1 transition-all duration-300 overflow-hidden"
              size="compact"
            >
              <p class="text-sm text-muted-foreground line-clamp-2 mb-3">{p.data.tagline}</p>
              {p.data.sizes.length > 0 ? (
                <p class="text-lg font-bold text-foreground mb-3">
                  From <span class="text-seal-600">R{Math.min(...p.data.sizes.map(s=>s.price)).toFixed(2)}</span>
                </p>
              ) : (
                <p class="text-lg font-bold text-foreground mb-3">Quote on request</p>
              )}
              <div slot="actions" class="flex items-center gap-3 w-full">
                <a href={waQuote(p.data.name)} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-sm flex-1 justify-center">
                  Get a quote
                </a>
                <a href={`/products/${p.id.replace('.md','')}`} class="btn btn-ghost btn-sm">
                  Details
                </a>
              </div>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessPath
    client:load
    heading="Our process"
    subheading="How we purify — a rigorous, multi-stage Reverse Osmosis process from source to sealed bottle."
    steps={[
      { number: '01', title: 'Source', body: 'Municipal water sourced and pre-filtered to remove sediment and chlorine.' },
      { number: '02', title: 'Reverse Osmosis', body: 'High-pressure RO membranes remove dissolved solids, bacteria and impurities.' },
      { number: '03', title: 'Mineral Balance', body: 'Controlled remineralisation for taste and pH balance.' },
      { number: '04', title: 'UV & Ozone', body: 'Final disinfection for microbiological safety.' },
      { number: '05', title: 'Bottling', body: 'Automated, hygienic filling and sealing in food-grade facilities.' },
      { number: '06', title: 'Quality Check', body: 'Every batch tested before release. Certificates of Analysis on request.' },
    ]}
  />

  <section class="section bg-surface-2">
    <div class="container">
      <header class="max-w-2xl mb-12">
        <span class="badge badge-seal mb-3">What we do</span>
        <h2 class="heading-2 text-foreground mb-3">Our services</h2>
        <p class="body-lg text-muted-foreground">Complete hydration solutions for homes, businesses, and events of any scale.</p>
      </header>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 reveal-stagger">
        {services.map((s) => (
          <div class="reveal-child">
            <Card
              title={s.data.name}
              classes="group bg-white border border-line shadow-soft hover:shadow-lift hover:-translate-y-1 transition-all duration-300"
              size="compact"
            >
              <p class="text-sm text-muted-foreground mb-4 leading-relaxed">{s.data.description}</p>
              <ul class="text-sm text-muted-foreground space-y-2">
                {s.data.features.slice(0,3).map((f) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-seal-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </Card>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/services" class="btn btn-outline">Explore all services →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid md:grid-cols-2 gap-16 items-center mb-16">
        <div class="reveal">
          <span class="badge badge-seal mb-4">Our story</span>
          <h2 class="heading-2 text-foreground mb-5">Built in Modimolle,<br/>serving our communities</h2>
          <p class="body text-muted-foreground mb-4 leading-relaxed">
            Founded in {site.founded} by Lesiba Maleka, Modi Hydroshop Pty Ltd purifies and bottles water in Modimolle, Limpopo, with a second base in Soweto, Gauteng. We source, train, motivate and guide our staff from the local communities we serve.
          </p>
          <p class="body text-muted-foreground mb-8 leading-relaxed">
            <strong class="text-foreground">Vision:</strong> To become the top supplier of bottled water and allied products in the country — a reputable, trustworthy alternative to the bigger suppliers.
          </p>
          <a href="/about" class="btn btn-outline">Read our story →</a>
        </div>

        <div class="grid grid-cols-2 gap-4 reveal-stagger">
          {[
            { t: 'Integrity', d: 'We conduct our business ethically and honestly.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
            { t: 'Quality', d: 'Quality products with the best value for money.', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z' },
            { t: 'Safety', d: 'Zero harm to people and the environment.', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
            { t: 'Respect', d: 'We value every individual and their differences.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z' },
          ].map((v) => (
            <div class="reveal-child bg-white rounded-2xl p-5 border border-line shadow-soft hover:shadow-lift hover:-translate-y-0.5 transition-all duration-300">
              <div class="w-9 h-9 rounded-lg bg-seal-100 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-seal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={v.icon}/></svg>
              </div>
              <h3 class="heading-4 text-foreground mb-1">{v.t}</h3>
              <p class="text-xs text-muted-foreground leading-snug">{v.d}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-3xl p-8 md:p-12 bg-gradient-to-br from-seal-50 to-seal-100 border border-seal-200">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <h3 class="heading-4 text-foreground mb-2">Water stewardship</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">Responsible sourcing and efficient RO processing to minimise waste per litre bottled.</p>
          </div>
          <div>
            <h3 class="heading-4 text-foreground mb-2">Local jobs</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">We source, train and grow staff from Modimolle and Soweto communities.</p>
          </div>
          <div>
            <h3 class="heading-4 text-foreground mb-2">B-BBEE Level 1</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">Verified contributor status, supporting procurement and enterprise development.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ReadinessBand
    client:load
    heading="Built for the next step"
    subheading="When a tender, a loan, or a scale move opens, the businesses that qualify are the ones already compliant."
    signals={[
      { stat: 'B-BBEE', label: 'Level 1 contributor. Your engagement with us counts toward your own procurement scorecard.' },
      { stat: 'CIPC', label: 'Registered company with full compliance documentation available.' },
      { stat: 'Quality', label: 'Rigorous purification and testing on every batch we produce.' },
    ]}
    ctaText="Request a quote"
    ctaHref="/contact"
  />

  <ValueProps
    client:load
    heading="Why Modi Water"
    subheading="What sets us apart from the rest."
    items={[
      { num: '01', title: 'Integrity', body: 'Honest, transparent dealings with every client and partner.' },
      { num: '02', title: 'Quality', body: 'Rigorous purification and testing on every batch we produce.' },
      { num: '03', title: 'Safety', body: 'Food-grade processes that meet the highest hygiene standards.' },
      { num: '04', title: 'Respect', body: 'We value our people, our clients, and our community.' },
    ]}
  />

  <TrustStrip
    client:load
    heading="Why choose Modi Water"
    subheading="If any of these matter to you, we should talk."
    stats={[
      { value: 'Pure Water', label: 'Multi-stage RO filtration, lab-tested for quality.' },
      { value: 'Free Delivery', label: 'No charge within our 8-town service area.' },
      { value: 'Local Support', label: 'Real people, fast response, based in Modimolle.' },
    ]}
  />

  <SocialCard
    client:load
    links={[
      { label: 'LinkedIn', href: 'https://www.linkedin.com/company/modihydroshop' },
      { label: 'Facebook', href: 'https://www.facebook.com/modihydroshop' },
    ]}
  />

  <section class="relative overflow-hidden bg-navy-900 text-white">
      <div class="absolute inset-0">
            <Silk client:load speed={3} scale={1.2} color="#1B3A6B" noiseIntensity={0.8} rotation={0} />
            <Strands client:load colors={["#2D7DD2", "#5FC8ED", "#0B1B3A"]} count={4} speed={0.3} amplitude={0.8} opacity={0.4} />
            <div class="absolute inset-0 bg-navy-950/40" />
          </div>
      <div class="container relative z-10 py-24 md:py-32 text-center max-w-3xl mx-auto">
        <MorphHeadline client:load as="h2" className="mb-5 text-white" style={{ fontSize: 'clamp(1.8rem, 3.5vw, 2.6rem)', lineHeight: 1.1 }}>
          Ready for premium hydration?
        </MorphHeadline>
        <p class="body-lg text-seal-200 mb-10 max-w-2xl mx-auto">
          Custom solutions, volume pricing and dedicated support for your business, hospitality venue or event. Get a quote today.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <SpecularButton client:load href={waQuote()} target="_blank" rel="noopener noreferrer" size="lg" baseColor="#2D7DD2" lineColor="#7DD3FC" textColor="#FFFFFF">
            Get a quote on WhatsApp
          </SpecularButton>
          <a href="mailto:lesibabdmaleka@gmail.com?subject=Quote%20request%20-%20Modi%20Hydroshop" class="btn btn-lg border border-white/30 text-white hover:bg-white hover:text-navy-900 backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5">
            Email us
          </a>
        </div>
        <p class="caption text-seal-100/70 mt-8">
          Or call {site.phone} · Mon–Fri 8am–5pm, Sat 8am–1pm
        </p>
      </div>
    </section>

</BaseLayout>
